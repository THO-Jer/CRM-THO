# Configuración local — copia este archivo a `.env` y rellena los valores.
# `.env` está en .gitignore para que no se suba al repo.
#
# En Vercel: Project Settings → Environment Variables. Las VITE_* se exponen
# al cliente; las que NO empiezan con VITE_ solo viven en el servidor.

# === Cliente (Vite — se compilan al bundle) ===
VITE_SUPABASE_URL=https://bepifbenblkqjuplvylh.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# === Servidor (solo Vercel — no se exponen al cliente) ===
# Service role key de Supabase — bypassa RLS. NUNCA exponer en cliente.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# Token compartido con tho-web para recibir leads en /api/public/leads.
# Debe coincidir EXACTO con el LEADS_API_KEY del proyecto tho-web.
LEADS_API_KEY=tu-token-compartido-aqui

# UUID del owner que recibe los leads de tho.cl.
# Se obtiene en Supabase Dashboard → Authentication → Users.
LEADS_OWNER_USER_ID=tu-user-id-aqui
